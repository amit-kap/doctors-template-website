---
/**
 * Native accessibility panel. No third-party overlay.
 * The site is accessible without it (Commission FAQ: toolbars are optional and never a substitute);
 * it is the visible, familiar "this site is accessible" indicator Israeli users expect.
 * Settings persist in localStorage and are applied before paint by the inline script in Base.astro.
 */
import { href, type Ctx } from '../i18n';
import Icon from './Icon.astro';
interface Props { ctx: Ctx }
const { ctx } = Astro.props;
const { a11y } = ctx.t;
const glyph = ctx.lang === 'he' ? 'א' : 'A';
const toggles = [
  { key: 'contrast', icon: 'contrast', label: a11y.contrast },
  { key: 'mono', icon: 'mono', label: a11y.monochrome },
  { key: 'links', icon: 'link', label: a11y.links },
  { key: 'readable', icon: 'type', label: a11y.readable },
  { key: 'spacing', icon: 'spacing', label: a11y.spacing },
  { key: 'motion', icon: 'pause', label: a11y.motion },
  { key: 'focus', icon: 'focus', label: a11y.focus },
];
---

<dialog data-ui class="a11y-dialog" id="a11y-dialog" aria-labelledby="a11y-title">
  <div class="a11y-head">
    <h2 id="a11y-title">{a11y.title}</h2>
    <button class="a11y-close" type="button" data-a11y-close>
      <Icon name="close" />
      <span class="visually-hidden">{a11y.close}</span>
    </button>
  </div>
  <div class="a11y-body">
    <div class="a11y-size" role="group" aria-labelledby="a11y-size-label">
      <span id="a11y-size-label">{a11y.textSize}</span>
      <div class="a11y-size-btns">
        <button type="button" data-a11y-scale="-1" aria-label={a11y.smaller}>{glyph}−</button>
        <output id="a11y-scale-out" aria-live="polite">100%</output>
        <button type="button" data-a11y-scale="1" aria-label={a11y.larger}>{glyph}+</button>
      </div>
    </div>
    <div class="a11y-grid">
      {toggles.map((x) => (
        <button class="a11y-toggle" type="button" aria-pressed="false" data-a11y-toggle={x.key}>
          <Icon name={x.icon} />
          <span>{x.label}</span>
        </button>
      ))}
      <button class="a11y-toggle" type="button" data-a11y-reset>
        <Icon name="reset" />
        <span>{a11y.reset}</span>
      </button>
    </div>
    <p class="a11y-note">{a11y.note}</p>
    <p class="visually-hidden" id="a11y-live" aria-live="polite" data-msg={a11y.resetDone}></p>
    <div class="a11y-foot">
      <a href={href(ctx, 'accessibility')}>{a11y.statement}</a>
    </div>
  </div>
</dialog>

<script>
  type State = { scale?: number } & Record<string, boolean | number | undefined>;
  const KEYS = ['contrast', 'mono', 'links', 'readable', 'spacing', 'motion', 'focus'];
  const STEPS = [1, 1.15, 1.3, 1.5, 1.75, 2];
  const root = document.documentElement;
  const dialog = document.getElementById('a11y-dialog') as HTMLDialogElement;
  const out = document.getElementById('a11y-scale-out')!;
  const load = (): State => { try { return JSON.parse(localStorage.getItem('a11y') || '{}'); } catch { return {}; } };
  let state = load();

  function apply() {
    const scale = state.scale ?? 1;
    if (scale === 1) root.style.removeProperty('--a11y-scale');
    else root.style.setProperty('--a11y-scale', String(scale));
    out.textContent = `${Math.round(scale * 100)}%`;
    const i = STEPS.indexOf(scale);
    (document.querySelector('[data-a11y-scale="-1"]') as HTMLButtonElement).disabled = i <= 0;
    (document.querySelector('[data-a11y-scale="1"]') as HTMLButtonElement).disabled = i >= STEPS.length - 1;
    KEYS.forEach((k) => {
      root.toggleAttribute(`data-a11y-${k}`, Boolean(state[k]));
      document.querySelector(`[data-a11y-toggle="${k}"]`)?.setAttribute('aria-pressed', String(Boolean(state[k])));
    });
    try { localStorage.setItem('a11y', JSON.stringify(state)); } catch {}
  }

  document.querySelectorAll('[data-a11y-open]').forEach((b) => b.addEventListener('click', () => dialog.showModal()));
  document.querySelector('[data-a11y-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  document.querySelectorAll<HTMLButtonElement>('[data-a11y-scale]').forEach((b) =>
    b.addEventListener('click', () => {
      const i = STEPS.indexOf(state.scale ?? 1);
      const next = Math.min(STEPS.length - 1, Math.max(0, (i < 0 ? 0 : i) + Number(b.dataset.a11yScale)));
      state.scale = STEPS[next];
      apply();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const k = b.dataset.a11yToggle!;
      state[k] = !state[k];
      apply();
    }),
  );
  document.querySelector('[data-a11y-reset]')?.addEventListener('click', () => {
    state = {}; apply();
    const note = document.getElementById('a11y-live')!;
    note.textContent = note.dataset.msg!;
  });
  apply();
</script>
