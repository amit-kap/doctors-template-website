---
import { href, type Ctx, type PageId, bookLink } from '../i18n';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';

interface Props { ctx: Ctx }
const { ctx } = Astro.props;
const { t } = ctx;
const items: PageId[] = ['home', 'about', 'services', 'appointment'];
const book = bookLink(ctx);
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={href(ctx, 'home')} aria-current={ctx.page === 'home' ? 'page' : undefined}>
      <span class="brand-name">{t.doctor.fullName}</span>
      <span class="brand-spec">{t.doctor.specialty}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label={t.ui.mainNav}>
      <ul class="nav-list" role="list">
        {items.map((p) => (
          <li>
            <a href={href(ctx, p)} aria-current={ctx.page === p ? 'page' : undefined}>{t.ui.nav[p]}</a>
          </li>
        ))}
        <li class="nav-a11y">
          <a href={href(ctx, 'accessibility')} aria-current={ctx.page === 'accessibility' ? 'page' : undefined}>
            {t.ui.nav.accessibility}
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitch ctx={ctx} />
      <a class="btn btn-primary btn-book" href={book.href} target={book.external ? '_blank' : undefined} rel={book.external ? 'noopener' : undefined}>
        <Icon name="calendar" />
        <span>{t.ui.book}</span>
        {book.external && <span class="visually-hidden"> {t.ui.newWindow}</span>}
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
        <span class="visually-hidden">{t.ui.menu}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      if (open) nav.querySelector<HTMLElement>('a')?.focus();
    };
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
    btn.addEventListener('click', () => set(!isOpen()));
    nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    btn.closest('header')!.addEventListener('focusout', (e) => {
      if (isOpen() && !btn.closest('header')!.contains(e.relatedTarget as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { set(false); btn.focus(); }
    });
  }
</script>

<style>
  .nav-a11y { display: none; }
  @media (max-width: 72rem) { .nav-a11y { display: block; } }
  .menu-toggle :global(.i-close) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.i-close) { display: block; }
  .menu-toggle[aria-expanded='true'] :global(.i-open) { display: none; }
  @media (max-width: 30rem) { .brand-spec { display: none; } }
</style>
