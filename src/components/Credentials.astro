---
import { latin, type Ctx } from '../i18n';
interface Props { ctx: Ctx; variant?: 'timeline' | 'columns' }
const { ctx, variant = 'columns' } = Astro.props;
const { t } = ctx;
const d = t.doctor;
---
<div class:list={['creds', `creds-${variant}`]}>
  <div>
    <h3 id="c-edu">{t.ui.credentialsTitle}</h3>
    <ol role="list" class="creds-list">
      {d.education.map((e) => (
        <li><span class="creds-year"><bdi dir="ltr">{e.year}</bdi></span><span><strong set:html={latin(e.title, ctx.lang)} /><br /><span class="muted">{e.place}</span></span></li>
      ))}
    </ol>
  </div>
  <div>
    <h3 id="c-pos">{t.ui.positionsTitle}</h3>
    <ol role="list" class="creds-list">
      {d.positions.map((e) => (
        <li><span class="creds-year">{e.year}</span><span><strong set:html={latin(e.title, ctx.lang)} /><br /><span class="muted">{e.place}</span></span></li>
      ))}
    </ol>
  </div>
  <div>
    <h3 id="c-mem">{t.ui.membershipsTitle}</h3>
    <ul class="creds-plain">{d.memberships.map((m) => <li>{m}</li>)}</ul>
  </div>
  <div>
    <h3 id="c-pub">{t.ui.publicationsTitle}</h3>
    <ul class="creds-plain">{d.publications.map((m) => <li>{m}</li>)}</ul>
  </div>
</div>
<style>
  .creds { display: grid; gap: var(--space-2xl) var(--space-xl); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .creds h3 { font-size: var(--step-1); margin-block-end: var(--space-m); }
  .creds-list { display: grid; gap: var(--space-m); }
  .creds-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: var(--space-m); }
  .creds-year { color: var(--primary); font-weight: 600; font-variant-numeric: tabular-nums; text-align: start; }
  .creds-plain { padding-inline-start: 1.1em; display: grid; gap: var(--space-xs); }
  .creds-timeline .creds-list { border-inline-start: 1px solid var(--line); padding-inline-start: var(--space-l); }
  .creds-timeline .creds-list li { position: relative; }
  .creds-timeline .creds-list li::before {
    content: ''; position: absolute; inset-inline-start: calc(-1 * var(--space-l) - 5px); inset-block-start: 0.55em;
    inline-size: 9px; block-size: 9px; border-radius: 50%; background: var(--primary);
  }
  @media (max-width: 30rem) { .creds-list li { grid-template-columns: 1fr; gap: 0; } }
</style>
