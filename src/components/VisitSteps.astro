---
import type { Ctx } from '../i18n';
interface Props { ctx: Ctx }
const { t } = Astro.props.ctx;
---
<ol class="visit" role="list">
  {t.visit.map((s, i) => (
    <li>
      <span class="visit-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
<style>
  .visit { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--space-l); }
  .visit li { display: grid; gap: var(--space-xs); align-content: start; padding-block-start: var(--space-m); border-block-start: 2px solid var(--primary); }
  .visit-n { font-family: var(--font-display); font-size: var(--step-2); color: var(--primary); line-height: 1; font-variant-numeric: tabular-nums; }
  .visit p { color: var(--muted); }
</style>
