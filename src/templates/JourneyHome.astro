---
/**
 * D · JOURNEY — calm, premium "patient journey" home.
 *
 * Order: hero · about (portrait) · treatments · first visit (sticky progress + step cards) ·
 * training and experience · FAQ · location and hours · closing call to action.
 *
 * Layout system: one 5 / 7 split (headings on the start edge, content on the 7-column edge),
 * two section paddings (--j-sec, --j-sec-s), two radii (--j-r-l panels and photos, --j-r-m cards),
 * one hairline (--j-hair). Type roles and their Hebrew values are tokens in themes.css.
 *
 * Motion: one language (rise 28px, mask-open for photos, slow parallax). Scroll-scrubbed with CSS
 * view() / scroll() timelines where supported, IntersectionObserver otherwise. transform, opacity and
 * clip-path only. Runs only with prefers-reduced-motion: no-preference and without the a11y "stop
 * motion" setting, and never hides content without JS (.jh-js is set by an inline script).
 *
 * No testimonials, numbers, prices or superlatives (Physicians Regulations, Prohibited Advertising, 2008).
 */
import { site } from '../site.config';
import { href, latin, whatsappHref, wazeHref, mapsHref, type Ctx, bookLink } from '../i18n';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import OpenNow from '../components/OpenNow.astro';
import Hours from '../components/Hours.astro';
import License from '../components/License.astro';
import Faq from '../components/Faq.astro';
import Arrow from './journey/Arrow.astro';
import Orb from './journey/Orb.astro';

interface Props { ctx: Ctx }
const { ctx } = Astro.props;
const { t } = ctx;
const d = t.doctor;
const j = t.journey;
const wa = whatsappHref();
const book = bookLink(ctx);
const bookAttrs = { href: book.href, target: book.external ? '_blank' : undefined, rel: book.external ? 'noopener' : undefined };
const steps = t.visit;
const phases = j.pathPhases ?? [];
const pad = (n: number) => String(n).padStart(2, '0');
// Step 1 (booking) shows the ways to book instead of a photo. The other steps get one photo each, cycled.
const stepImages = ['interior-detail', 'exam-otoscope', 'detail-stethoscope'];
const stepFocus = ['70% 60%', '42% 55%', '50% 40%'];
const treatments = t.services.slice(0, 3);
const moreTreatments = t.services.slice(3);
const physical = Object.entries(site.accessibility.physical) as [keyof typeof t.statement.physicalLabels, boolean][];
const alternatives = t.statement.physicalAlternatives as Partial<Record<string, string>>;
---
<script is:inline>document.documentElement.classList.add('jh-js');</script>

<section class="jh-hero" aria-labelledby="hero-h" data-jh-hero>
  <div class="jh-stage">
    <div class="jh-bg" aria-hidden="true">
      <Img ctx={ctx} name="kids-corner" decorative eager width={2000} height={1333} sizes="100vw" />
    </div>

    <div class="jh-body">
      <p class="jh-label jh-in" style="--d:0">{j.heroLabel}<span class="jh-sep" aria-hidden="true"></span>{t.address.city}</p>
      <h1 id="hero-h" class="jh-h1">
        {j.heroLines.map((line, i) => (
          <><span class="jh-line"><span style={`--i:${i}`}>{line}</span></span>{i < j.heroLines.length - 1 ? ' ' : ''}</>
        ))}
      </h1>
      <p class="jh-intro jh-in" style="--d:1">{d.intro}</p>
      <div class="jh-cta jh-in" style="--d:2">
        <a class="btn jh-pill jh-pill-dark" {...bookAttrs}>
          {j.bookFirst}<Arrow />{book.external && <span class="visually-hidden"> {t.ui.newWindow}</span>}
        </a>
        <a class="btn jh-pill jh-pill-line" href={`tel:${site.contact.phoneHref}`}>
          <Icon name="phone" /><span class="visually-hidden">{t.ui.callFull}: </span><span dir="ltr">{site.contact.phone}</span>
        </a>
        {wa && (
          <a class="btn jh-pill jh-pill-wa" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" />{t.ui.whatsapp}<span class="visually-hidden"> {t.ui.newWindow}</span>
          </a>
        )}
      </div>
    </div>

    <ul class="jh-facts jh-in" style="--d:3" role="list" aria-label={j.factsLabel}>
      <li>
        <span class="jh-fact-k">{j.specialtyLabel}</span>
        <span class="jh-fact-v">{d.specialty}</span>
      </li>
      <li>
        <span class="jh-fact-k">{t.ui.address}</span>
        <span class="jh-fact-v">{t.address.street}, {t.address.city}</span>
        <a class="jh-fact-a" href={wazeHref()} target="_blank" rel="noopener">{t.ui.openWaze}<Arrow /><span class="visually-hidden"> {t.ui.newWindow}</span></a>
      </li>
      <li>
        <span class="jh-fact-k">{t.ui.hours}</span>
        <OpenNow ctx={ctx} class="jh-fact-v jh-open" />
        <a class="jh-fact-a" href="#jx-hours">{j.allHours}</a>
      </li>
      <li>
        <span class="jh-fact-k">{t.ui.insuranceTitle}</span>
        <span class="jh-fact-v jh-fact-ins">{t.insurance.items.map((item, i) => <><span class="jh-nw">{item}</span>{i < t.insurance.items.length - 1 ? ' · ' : ''}</>)}</span>
      </li>
    </ul>
  </div>
</section>

<section class="jx-about" aria-labelledby="about-h">
  <div class="jx-ghost" aria-hidden="true" data-decor data-word={d.name}></div>
  <div class="wrap jx-about-grid">
    <div class="jx-about-text">
      <h2 id="about-h" class="jh-label" data-rise>{j.aboutLabel}</h2>
      <p class="jx-statement" data-rise style="--k:1">{d.shortBio}</p>
      <div class="jx-about-foot" data-rise style="--k:2">
        <p class="jx-about-more">{d.bio[2] ?? d.philosophy}</p>
        <div class="jx-about-act">
          <a class="btn jh-pill jh-pill-dark" href={href(ctx, 'about')}>{t.ui.aboutMore}<Arrow /></a>
          <License ctx={ctx} />
        </div>
      </div>
    </div>
    <figure class="jx-portrait">
      <div class="jx-mask" data-wipe>
        <Img ctx={ctx} name={site.doctor.portrait} width={900} height={1100} sizes="(max-width: 48rem) 92vw, 32rem" />
      </div>
      <figcaption data-rise>
        <span class="jx-cap-n">{d.fullName}</span>
        <span class="jx-cap-s">{d.specialty}</span>
      </figcaption>
    </figure>
  </div>
</section>

<section class="jx-treat" aria-labelledby="treat-h">
  <div class="wrap">
    <div class="jx-head jx-head-row" data-rise>
      <div class="jx-head-main">
        <p class="jh-label">{j.treatmentsLabel}</p>
        <h2 id="treat-h" class="jx-h2">{j.treatmentsTitle}</h2>
      </div>
      <a class="jx-link" href={href(ctx, 'services')}>{t.ui.allServices}<Arrow /></a>
    </div>
    <ul class="jx-cards" role="list">
      {treatments.map((s, i) => (
        <li class="jx-card" data-rise style={`--k:${i}`}>
          <div class="jx-card-art" data-tone={i % 3} aria-hidden="true"><Orb variant={i} /></div>
          <h3>{s.title}</h3>
          <p class="jx-card-sum">{s.summary}</p>
          <ul class="jx-card-list" role="list">
            {s.details.slice(0, 3).map((x) => <li>{x}</li>)}
          </ul>
          <a class="jx-link" href={href(ctx, 'services', ctx.lang, `#${s.id}`)}>
            {t.ui.readMore}<span class="visually-hidden">: {s.title}</span><Arrow />
          </a>
        </li>
      ))}
    </ul>
    {moreTreatments.length > 0 && (
      <div class="jx-more" data-rise>
        <h3 class="jx-more-k">{j.alsoLabel}</h3>
        <ul class="jx-more-list" role="list">
          {moreTreatments.map((s) => (
            <li><a class="jx-chip" href={href(ctx, 'services', ctx.lang, `#${s.id}`)}>{s.title}<Arrow /></a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<section class="jv" aria-labelledby="visit-h" data-jv style={`--n:${steps.length}`}>
  <div class="wrap jx-split jv-grid">
    <div class="jv-side">
      <div class="jv-sticky" data-rise>
        <p class="jh-label">{j.pathLabel}</p>
        <h2 id="visit-h" class="jx-h2">{j.pathTitle}</h2>
        <p class="jx-lead">{j.visitIntro}</p>

        <nav class="jv-progress" aria-label={j.pathLabel}>
          <ol class="jv-rail" role="list">
            {steps.map((s, i) => (
              <li class="jv-node" data-jv-node={i}>
                <a href={`#jv-step-${i + 1}`}>
                  <span class="jv-node-dot" aria-hidden="true">{i + 1}</span>
                  <span class="jv-node-text">
                    {phases[i] && <span class="jv-node-k">{phases[i]}</span>}
                    <span class="jv-node-t">{s.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>

    <ol class="jv-steps" role="list">
      {steps.map((s, i) => (
        <li class="jv-step" id={`jv-step-${i + 1}`} data-jv-step={i} data-rise>
          <div class="jv-body">
            <p class="jv-tag">
              <span class="jv-num" aria-hidden="true">{pad(i + 1)}</span>
              {phases[i] && <span class="jv-phase">{phases[i]}</span>}
            </p>
            <div class="jv-copy">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </div>
          {i === 0 ? (
            <div class="jv-media jv-ways">
              <a class="btn jh-pill jh-pill-dark" {...bookAttrs}>
                {t.ui.book}<Arrow />{book.external && <span class="visually-hidden"> {t.ui.newWindow}</span>}
              </a>
              <a class="btn jh-pill jh-pill-line" href={`tel:${site.contact.phoneHref}`}>
                <Icon name="phone" /><span class="visually-hidden">{t.ui.callFull}: </span><span dir="ltr">{site.contact.phone}</span>
              </a>
              {wa && (
                <a class="btn jh-pill jh-pill-line" href={wa} target="_blank" rel="noopener">
                  <Icon name="whatsapp" />{t.ui.whatsapp}<span class="visually-hidden"> {t.ui.newWindow}</span>
                </a>
              )}
            </div>
          ) : (
            <div class="jv-media" style={`--pos:${stepFocus[(i - 1) % stepFocus.length]}`}>
              <Img ctx={ctx} name={stepImages[(i - 1) % stepImages.length]} decorative width={800} height={1000} sizes="(max-width: 48rem) 92vw, 18rem" />
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>

  <div class="wrap jv-end" data-rise>
    <p>{j.pathEnd}</p>
    <a class="btn jh-pill jh-pill-dark" {...bookAttrs}>
      {j.bookFirst}<Arrow />{book.external && <span class="visually-hidden"> {t.ui.newWindow}</span>}
    </a>
  </div>
</section>

<section class="jx-cred" aria-labelledby="cred-h">
  <div class="wrap">
    <div class="jx-head jx-split" data-rise>
      <div class="jx-head-main">
        <p class="jh-label">{j.doctorLabel}</p>
        <h2 id="cred-h" class="jx-h2">{j.credTitle}</h2>
      </div>
      <p class="jx-cred-quote">{d.philosophy}</p>
    </div>
    <div class="jx-ledger">
      <div class="jx-group jx-split" data-rise>
        <h3>{t.ui.credentialsTitle}</h3>
        <ul class="jx-rows" role="list">
          {d.education.map((e) => (
            <li><span class="jx-year"><span dir="ltr">{e.year}</span></span><span class="jx-row-main"><span class="jx-row-t" set:html={latin(e.title, ctx.lang)} /><span class="jx-row-p">{e.place}</span></span></li>
          ))}
        </ul>
      </div>
      <div class="jx-group jx-split" data-rise>
        <h3>{t.ui.positionsTitle}</h3>
        <ul class="jx-rows" role="list">
          {d.positions.map((e) => (
            <li><span class="jx-year">{e.year}</span><span class="jx-row-main"><span class="jx-row-t">{e.title}</span><span class="jx-row-p">{e.place}</span></span></li>
          ))}
        </ul>
      </div>
      <div class="jx-group jx-split" data-rise>
        <h3>{t.ui.membershipsTitle}</h3>
        <ul class="jx-rows jx-rows-plain" role="list">{d.memberships.map((m) => <li>{m}</li>)}</ul>
      </div>
      <div class="jx-group jx-split" data-rise>
        <h3>{t.ui.languagesSpoken}</h3>
        <ul class="jx-tags" role="list">{d.languages.map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<section class="jx-faq" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="jx-faq-panel" data-grow>
    <div class="jx-faq-inner">
      <div class="jx-head jx-head-center" data-rise>
        <p class="jh-label">{j.faqLabel}</p>
        <h2 id="faq-h" class="jx-h2">{t.ui.faqTitle}</h2>
      </div>
      <div data-rise style="--k:1"><Faq ctx={ctx} /></div>
    </div>
    </div>
  </div>
</section>

<section class="jx-loc" aria-labelledby="loc-h">
  <div class="wrap">
    <div class="jx-head" data-rise>
      <p class="jh-label">{j.locationLabel}</p>
      <h2 id="loc-h" class="jx-h2">{t.ui.directions}</h2>
    </div>
    <div class="jx-split jx-loc-grid">
      <figure class="jx-loc-photo">
        <div class="jx-mask" data-wipe data-par>
          <Img ctx={ctx} name="building-tlv" decorative width={1200} height={1500} sizes="(max-width: 56rem) 92vw, 30rem" />
        </div>
      </figure>
      <div class="jx-book">
        <div class="jx-entry" data-rise>
          <h3>{t.ui.address}</h3>
          <div class="jx-entry-body">
            <p class="jx-big">{t.address.street}, {t.address.city}</p>
            <p class="jx-muted">{t.address.notes}</p>
            <div class="jx-pills">
              <a class="btn jh-pill jh-pill-dark" href={wazeHref()} target="_blank" rel="noopener">{t.ui.openWaze}<Arrow /><span class="visually-hidden"> {t.ui.newWindow}</span></a>
              <a class="btn jh-pill jh-pill-line" href={mapsHref()} target="_blank" rel="noopener">{t.ui.openMaps}<Arrow /><span class="visually-hidden"> {t.ui.newWindow}</span></a>
            </div>
          </div>
        </div>
        <div class="jx-entry" id="jx-hours" tabindex="-1" data-rise>
          <h3>{t.ui.hours}</h3>
          <div class="jx-entry-body">
            <OpenNow ctx={ctx} class="jx-open" />
            <Hours ctx={ctx} />
            <a class="jx-phone" href={`tel:${site.contact.phoneHref}`}><Icon name="phone" /><span class="visually-hidden">{t.ui.callFull}: </span><span dir="ltr">{site.contact.phone}</span></a>
          </div>
        </div>
        <div class="jx-entry" data-rise>
          <h3>{t.statement.physicalTitle}</h3>
          <ul class="jx-access jx-entry-body" role="list">
            {physical.map(([key, ok]) => (
              <li data-ok={ok ? '' : undefined}>
                <Icon name={ok ? 'check' : 'close'} />
                <span>
                  {t.statement.physicalLabels[key]}<span class="visually-hidden">: {ok ? t.statement.yes : t.statement.no}</span>
                  {!ok && alternatives[key] && <span class="jx-alt">{alternatives[key]}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="jx-cta" aria-labelledby="cta-h">
  <div class="jx-cta-card" data-grow>
    <div class="jx-cta-body">
      <p class="jh-label" data-rise>{j.ctaLabel}</p>
      <h2 id="cta-h" data-rise style="--k:1">{j.ctaTitle}</h2>
      <p class="jx-cta-text" data-rise style="--k:2">{j.ctaText}</p>
      <div class="jx-pills" data-rise style="--k:3">
        <a class="btn jh-pill jh-pill-dark" {...bookAttrs}>
          {j.bookFirst}<Arrow />{book.external && <span class="visually-hidden"> {t.ui.newWindow}</span>}
        </a>
        <a class="btn jh-pill jh-pill-line" href={`tel:${site.contact.phoneHref}`}>
          <Icon name="phone" /><span class="visually-hidden">{t.ui.callFull}: </span><span dir="ltr">{site.contact.phone}</span>
        </a>
        {wa && (
          <a class="btn jh-pill jh-pill-line" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" />{t.ui.whatsapp}<span class="visually-hidden"> {t.ui.newWindow}</span>
          </a>
        )}
      </div>
    </div>
    <figure class="jx-cta-photo">
      <div class="jx-mask" data-par>
        <Img ctx={ctx} name="teddy-otoscope" width={1600} height={900} sizes="(max-width: 56rem) 92vw, 34rem" />
      </div>
    </figure>
  </div>
</section>


<script>
  const root = document.documentElement;
  const motionMq = matchMedia('(prefers-reduced-motion: no-preference)');
  const motionOk = () => motionMq.matches && !root.hasAttribute('data-a11y-motion');
  const sdt = CSS.supports('animation-timeline: view()');
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  // ---------- First visit: active step, counter, progress (scrubbed by scroll position) ----------
  const sec = document.querySelector<HTMLElement>('[data-jv]');
  const list = sec?.querySelector<HTMLElement>('.jv-steps');
  const items = sec ? [...sec.querySelectorAll<HTMLElement>('[data-jv-step]')] : [];
  const nodes = sec ? [...sec.querySelectorAll<HTMLElement>('[data-jv-node]')] : [];
  let active = -1;
  let frame = 0;

  const update = () => {
    frame = 0;
    const live = motionOk();
    sec?.classList.toggle('is-live', live);

    if (!sec || !list || !items.length) return;
    const mid = innerHeight * 0.55;
    const r = list.getBoundingClientRect();
    sec.style.setProperty('--p', clamp((mid - r.top) / r.height).toFixed(4));
    let idx = 0;
    const tops = items.map((li) => li.getBoundingClientRect().top);
    tops.forEach((top, i) => { if (top < mid) idx = i; });
    // Stepper line: reaches each stop exactly when its card becomes the active one.
    const within = idx < items.length - 1 ? clamp((mid - tops[idx]) / (tops[idx + 1] - tops[idx])) : 0;
    sec.style.setProperty('--q', clamp((idx + within) / Math.max(1, items.length - 1)).toFixed(4));
    if (idx !== active) {
      active = idx;
      items.forEach((li, i) => li.toggleAttribute('data-active', i === idx));
      nodes.forEach((n, i) => {
        n.toggleAttribute('data-active', i === idx);
        n.toggleAttribute('data-done', i < idx);
        const a = n.querySelector('a');
        if (i === idx && live) a?.setAttribute('aria-current', 'step'); else a?.removeAttribute('aria-current');
      });
    }
  };
  const request = () => { if (!frame) frame = requestAnimationFrame(update); };
  addEventListener('scroll', request, { passive: true });
  addEventListener('resize', request);
  motionMq.addEventListener('change', request);
  new MutationObserver(request).observe(root, { attributes: true, attributeFilter: ['data-a11y-motion'] });
  update();

  // Reveal fallback when CSS scroll-driven animations are not supported.
  if (!sdt && 'IntersectionObserver' in window) {
    root.classList.add('jh-io');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('[data-rise], [data-wipe], [data-grow]').forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ==========================================================================
     Type roles (sizes, leading and tracking come from themes.css tokens)
     ========================================================================== */
  /* The label (.jh-label) and pill buttons (.jh-pill-*) live in themes.css: the inner pages use them too. */
  .jh-sep { inline-size: 1.5rem; block-size: 1px; background: currentColor; opacity: 0.7; }

  .jx-h2 {
    font-size: var(--j-h2);
    font-weight: var(--j-w-display);
    line-height: var(--j-lh-h2);
    letter-spacing: var(--j-tr-h2);
    max-inline-size: 12em;
    overflow-wrap: anywhere;
  }
  .jx-lead { font-size: var(--j-lead); line-height: var(--j-lh-lead); color: var(--muted); max-inline-size: 26em; }

  .jx-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-block-size: 2.75rem;
    color: var(--fg);
    font-weight: var(--j-w-strong);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in oklch, var(--fg) 38%, transparent);
    text-underline-offset: 0.32em;
  }
  .jx-link:hover { text-decoration-color: currentColor; }

  /* ==========================================================================
     Layout primitives
     ========================================================================== */
  .jx-split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl) var(--j-gap);
    align-items: start;
  }
  .jx-head { display: grid; gap: var(--space-m); margin-block-end: var(--j-sec-s); }
  .jx-head.jx-split { align-items: end; gap: var(--space-l) var(--j-gap); }
  .jx-head-row { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-m) var(--space-xl); }
  .jx-head-main { display: grid; gap: var(--space-m); }
  .jx-head-center { justify-items: center; text-align: center; }
  .jx-head-center .jh-label { justify-content: center; }
  .jx-pills { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  /* Photo frame: the mask opens and the photo settles as it scrolls in. */
  .jx-mask { position: relative; overflow: clip; border-radius: var(--j-r-l); background: var(--jr-sage); }
  .jx-mask :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .jx-mask[data-par] :global(img) { position: absolute; inset: -6% 0; block-size: 112%; }

  /* ==========================================================================
     1 · Hero
     ========================================================================== */
  /* Full-width photo under a light veil. Text is centred on the page column; the facts card sits on the column too. */
  .jh-hero { position: relative; isolation: isolate; overflow: clip; }
  .jh-stage { display: flex; flex-direction: column; min-block-size: min(54rem, calc(100svh - 8rem)); }
  .jh-bg { position: absolute; inset: 0; z-index: -1; overflow: clip; background: var(--jr-sage); }
  .jh-bg :global(img) {
    position: absolute;
    inset: -6% 0 auto;
    inline-size: 100%;
    block-size: 112%;
    object-fit: cover;
    object-position: 50% 62%;
    /* A slight blur keeps the text readable; the small scale hides the soft edges the blur leaves. */
    filter: saturate(1.15) blur(4px);
    transform: scale(1.03);
  }
  .jh-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(oklch(98.5% 0.004 100 / 0.54), oklch(98.5% 0.004 100 / 0.66)); }
  .jh-body {
    flex: 1;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(1.1rem, 0.8rem + 1vw, 1.75rem);
    inline-size: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding-block: clamp(3rem, 1.5rem + 5vw, 6rem) clamp(2.25rem, 1.2rem + 3vw, 3.75rem);
    text-align: center;
  }
  .jh-body .jh-label { justify-content: center; color: var(--fg); }
  .jh-body .jh-label::before { display: none; }
  .jh-h1 {
    font-size: var(--j-display);
    font-weight: var(--j-w-display);
    line-height: var(--j-lh-display);
    letter-spacing: var(--j-tr-display);
  }
  .jh-line { display: block; overflow: clip; padding-block: 0.04em 0.14em; margin-block-end: -0.12em; }
  .jh-line > span { display: inline-block; }
  .jh-intro { max-inline-size: 33em; color: var(--fg); font-size: var(--j-lead); line-height: var(--j-lh-lead); }
  .jh-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-xs); margin-block-start: var(--space-xs); }
  .jh-cta .jh-pill-line { background: oklch(100% 0 none / 0.78); }

  .jh-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    inline-size: min(100% - 2 * var(--gutter), var(--max));
    margin: 0 auto clamp(1.5rem, 1rem + 2vw, 3rem);
    border: 1px solid var(--j-hair);
    border-radius: var(--j-r-m);
    background: var(--surface);
    font-size: var(--j-small);
    line-height: 1.5;
  }
  .jh-facts li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: clamp(1.1rem, 0.9rem + 0.6vw, 1.5rem) clamp(1.1rem, 0.8rem + 0.9vw, 1.75rem);
  }
  .jh-facts li + li { border-inline-start: 1px solid var(--j-hair); }
  .jh-fact-k { color: var(--muted); font-size: var(--j-label); font-weight: var(--j-w-strong); letter-spacing: var(--j-tr-label); line-height: 1.4; }
  :global(:lang(en)) .jh-fact-k { text-transform: uppercase; font-size: 0.75rem; }
  .jh-fact-v { color: var(--fg); font-weight: var(--j-w-strong); font-size: var(--j-body); line-height: 1.45; }
  .jh-fact-ins { font-weight: 400; }
  .jh-facts :global(.jh-open) { display: flex; align-items: center; gap: 0.5em; margin: 0; }
  .jh-nw { white-space: nowrap; }
  .jh-fact-a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: 2.75rem;
    margin-block: -0.4rem -0.7rem;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in oklch, var(--fg) 38%, transparent);
    text-underline-offset: 0.3em;
  }
  .jh-fact-a:hover { text-decoration-color: currentColor; }

  /* Hero motion: lines rise from behind a mask, then the rest follows; the photo settles and drifts slowly on scroll. */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-a11y-motion]) .jh-line > span { animation: jh-line 1100ms var(--j-ease) both; animation-delay: calc(120ms + var(--i) * 90ms); }
    :root:not([data-a11y-motion]) .jh-in { animation: jh-rise 900ms var(--j-ease) both; animation-delay: calc(520ms + var(--d) * 110ms); }
    :root:not([data-a11y-motion]) .jh-bg :global(img) { animation: jh-settle 1600ms var(--j-ease) both; }
  }
  @keyframes jh-line { from { transform: translateY(112%); } }
  @keyframes jh-rise { from { opacity: 0; transform: translateY(28px); } }
  @keyframes jh-settle { from { transform: scale(1.08); } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :root:not([data-a11y-motion]) .jh-bg :global(img) { animation: jh-settle 1600ms var(--j-ease) both, jh-parallax linear both; }
      /* Timeline longhands sit in a more specific rule so the minifier can't fold them into the shorthand. */
      html:root:not([data-a11y-motion]) .jh-bg :global(img) { animation-timeline: auto, scroll(root); animation-range: normal, 0 100svh; }
    }
  }
  @keyframes jh-parallax { to { translate: 0 10%; } }

  /* ==========================================================================
     2 · About
     ========================================================================== */
  .jx-about { position: relative; isolation: isolate; overflow: clip; padding-block: var(--j-sec); }
  /* Big faded display word behind the section (the doctor's name). Drawn from an attribute, so it is
     never read out or selected. Drifts sideways with the scroll. */
  .jx-ghost {
    --j-dir: 1;
    position: absolute;
    z-index: -1;
    inset-block-start: clamp(1rem, 3vw, 3rem);
    inset-inline: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
    user-select: none;
  }
  :global([dir='rtl']) .jx-ghost { --j-dir: -1; }
  .jx-ghost::before {
    content: attr(data-word);
    flex: none;
    font-size: clamp(4.5rem, 19vw, 19rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--j-tr-display);
    white-space: nowrap;
    color: oklch(90% 0.028 190);
    -webkit-mask-image: linear-gradient(#000 15%, transparent 92%);
    mask-image: linear-gradient(#000 15%, transparent 92%);
  }
  .jx-about-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl) var(--j-gap);
    align-items: end;
    padding-block-start: clamp(3rem, 8.5vw, 8.5rem);
  }
  .jx-about-text { display: grid; gap: var(--space-l); }
  .jx-statement {
    font-size: var(--j-statement);
    font-weight: var(--j-w-display);
    line-height: calc(var(--j-lh-h3) + 0.03);
    letter-spacing: var(--j-tr-h3);
    max-inline-size: 23em;
  }
  .jx-about-foot {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--space-xl);
    align-items: start;
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--j-hair);
  }
  .jx-about-more { color: var(--muted); max-inline-size: 30em; }
  .jx-about-act { display: grid; gap: var(--space-m); justify-items: start; }
  .jx-about-act :global(.license) { display: flex; flex-wrap: wrap; gap: 0 1rem; color: var(--muted); font-size: var(--j-small); line-height: 1.5; }
  .jx-about-act :global(.license a) { color: var(--fg); min-block-size: 2.75rem; display: inline-flex; align-items: center; text-underline-offset: 0.3em; }
  .jx-portrait { display: grid; gap: var(--space-s); }
  .jx-portrait .jx-mask { aspect-ratio: 4 / 5; }
  .jx-portrait :global(img) { object-position: 50% 12%; }
  .jx-portrait figcaption { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 var(--space-m); padding-inline: 0.25rem; }
  .jx-cap-n { font-weight: var(--j-w-strong); }
  .jx-cap-s { color: var(--muted); font-size: var(--j-small); }

  /* ==========================================================================
     3 · Treatments
     ========================================================================== */
  .jx-treat { padding-block: 0 var(--j-sec-s); }
  .jx-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); }
  /* Cards share their rows (subgrid), so titles, summaries, lists and links line up across the row. */
  .jx-card {
    --pad: clamp(1rem, 0.7rem + 0.9vw, 1.5rem);
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: 0.5rem;
    border: 1px solid var(--j-hair);
    border-radius: var(--j-r-m);
    background: var(--surface);
  }
  .jx-card > :not(.jx-card-art) { margin-inline: var(--pad); }
  .jx-card-art {
    aspect-ratio: 16 / 10;
    overflow: clip;
    border-radius: calc(var(--j-r-m) - 0.5rem);
    color: oklch(48% 0.02 280);
    background: var(--tone, var(--jr-sage));
  }
  .jx-card-art[data-tone='0'] { --tone: var(--jr-sage); }
  .jx-card-art[data-tone='1'] { --tone: var(--jr-lilac); }
  .jx-card-art[data-tone='2'] { --tone: var(--jr-yellow); }
  .jx-card h3 { margin-block-start: clamp(1.25rem, 1rem + 0.9vw, 1.75rem); font-size: var(--j-h3); font-weight: var(--j-w-strong); letter-spacing: var(--j-tr-h3); line-height: var(--j-lh-h3); }
  .jx-card-sum { margin-block-start: var(--space-s); color: var(--muted); }
  .jx-card-list { display: grid; align-content: start; margin-block: var(--space-l) var(--space-m); border-block-start: 1px solid var(--j-hair); font-size: var(--j-small); line-height: 1.5; }
  .jx-card-list li { display: flex; align-items: baseline; gap: 0.75rem; padding-block: 0.7rem; border-block-end: 1px solid var(--j-hair); }
  .jx-card-list li::before { content: ''; flex: none; inline-size: 0.35rem; block-size: 0.35rem; border-radius: 50%; background: var(--fg); translate: 0 -0.2em; }
  .jx-card .jx-link { justify-self: start; margin-block-end: clamp(0.25rem, 0.1rem + 0.5vw, 0.75rem); }

  .jx-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--j-hair);
  }
  .jx-more-k { font-family: var(--font-body); font-size: var(--j-body); font-weight: var(--j-w-strong); letter-spacing: 0; line-height: 1.4; color: var(--muted); }
  .jx-more-list { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .jx-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-block-size: 2.75rem;
    padding-inline: 1.15em;
    border: 1px solid color-mix(in oklch, var(--fg) 34%, transparent);
    border-radius: 999px;
    color: var(--fg);
    font-weight: var(--j-w-strong);
    text-decoration: none;
    transition: background-color 240ms var(--j-ease), border-color 240ms var(--j-ease);
  }
  @media (hover: hover) and (pointer: fine) { .jx-chip:hover { background: var(--surface); border-color: var(--fg); } }

  /* ==========================================================================
     4 · First visit
     ========================================================================== */
  .jv { padding-block: var(--j-sec); }

  .jv-side { align-self: stretch; }
  .jv-sticky { display: grid; gap: var(--space-m); justify-items: start; }
  .jv-sticky .jx-lead { margin-block-start: var(--space-xs); }

  /* Stepper: one numbered stop per step, joined by a line that fills as the page scrolls.
     Each stop names the phase of the visit and links to its card. */
  .jv-progress { margin-block-start: var(--space-xl); inline-size: 100%; }
  .jv-rail { --dot: 2.5rem; --row: 4.75rem; position: relative; isolation: isolate; display: grid; }
  .jv-rail::before, .jv-rail::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: calc(var(--row) / 2);
    inset-inline-start: calc(var(--dot) / 2 - 1px);
    inline-size: 2px;
  }
  .jv-rail::before { background: var(--j-hair); }
  .jv-rail::after { background: var(--fg); transform: scaleY(0); transform-origin: 50% 0; }
  .jv-node a { display: flex; align-items: center; gap: 1rem; min-block-size: var(--row); color: var(--muted); text-decoration: none; }
  .jv-node-dot {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: var(--dot);
    block-size: var(--dot);
    border-radius: 50%;
    border: 1.5px solid color-mix(in oklch, var(--fg) 40%, transparent);
    background: var(--bg);
    color: var(--fg);
    font-size: var(--j-small);
    font-weight: var(--j-w-strong);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition: background-color 300ms var(--j-ease), border-color 300ms var(--j-ease), color 300ms var(--j-ease), box-shadow 300ms var(--j-ease);
  }
  .jv-node-text { display: grid; gap: 0.1rem; }
  .jv-node-k { font-size: var(--j-small); line-height: 1.4; }
  .jv-node-t { color: var(--fg); font-size: var(--j-lead); font-weight: var(--j-w-strong); line-height: 1.3; letter-spacing: var(--j-tr-h3); transition: color 300ms var(--j-ease); }
  @media (hover: hover) and (pointer: fine) {
    .jv-node a:hover .jv-node-dot { border-color: var(--fg); }
    .jv-node a:hover .jv-node-t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
  }

  .jv-steps { display: grid; gap: var(--space-m); }
  .jv-step {
    scroll-margin-block-start: calc(6.5rem + var(--showcase-h, 0px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(11rem, 38%, 17rem);
    gap: 0.5rem;
    min-block-size: clamp(17rem, 14rem + 7vw, 20rem);
    padding: 0.5rem;
    border: 1px solid var(--j-hair);
    border-radius: var(--j-r-m);
    background: var(--surface);
    isolation: isolate;
  }
  .jv-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: clamp(1rem, 0.7rem + 1vw, 1.75rem);
  }
  .jv-tag { display: flex; align-items: center; gap: 0.75rem; margin: 0; }
  .jv-phase { color: var(--muted); font-size: var(--j-small); font-weight: var(--j-w-strong); line-height: 1.4; }
  .jv-num {
    display: grid;
    place-items: center;
    min-inline-size: 3.25rem;
    block-size: 2.25rem;
    padding-inline: 0.9rem;
    border-radius: 999px;
    background: var(--fg);
    color: #fff;
    font-size: var(--j-small);
    font-weight: var(--j-w-strong);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .jv-copy { display: grid; gap: var(--space-xs); }
  .jv-copy h3 { font-size: var(--j-h3); font-weight: var(--j-w-strong); letter-spacing: var(--j-tr-h3); line-height: var(--j-lh-h3); }
  .jv-copy p { color: var(--muted); max-inline-size: 30em; }
  .jv-media { position: relative; overflow: clip; border-radius: calc(var(--j-r-m) - 0.5rem); background: var(--jr-sage); }
  .jv-media :global(img) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); }
  .jv-ways {
    --focus: oklch(50% 0.2 260);
    display: grid;
    align-content: center;
    gap: var(--space-xs);
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    background: var(--jr-yellow);
  }
  .jv-ways .btn { inline-size: 100%; padding-inline: 0.9em; }

  .jv-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m) var(--space-xl);
    margin-block-start: var(--j-sec-s);
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--j-hair);
  }
  .jv-end p { font-size: var(--j-h3); font-weight: var(--j-w-display); letter-spacing: var(--j-tr-h3); line-height: var(--j-lh-h3); max-inline-size: 24em; }

  @media (min-width: 56.01rem) and (min-height: 38rem) {
    .jv-sticky { position: sticky; inset-block-start: calc(5rem + var(--showcase-h, 0px) + var(--space-xl)); }
    .jv-steps { padding-block-end: 2vh; }
  }

  /* Live state (JS + motion allowed): the step in the middle of the screen is the active one.
     Only the photo and the number chip change; text keeps full contrast at all times. */
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-a11y-motion]) .jv.is-live .jv-rail::after { transform: scaleY(var(--q, 0)); }
    :root:not([data-a11y-motion]) .jv.is-live .jv-node:not([data-active], [data-done]) .jv-node-t { color: var(--muted); }
    :root:not([data-a11y-motion]) .jv.is-live .jv-node:is([data-active], [data-done]) .jv-node-dot { background: var(--fg); border-color: var(--fg); color: #fff; }
    :root:not([data-a11y-motion]) .jv.is-live .jv-node[data-active] .jv-node-dot { box-shadow: 0 0 0 5px var(--jr-sage-2); }
    :root:not([data-a11y-motion]) .jv.is-live .jv-step { transition: border-color 500ms var(--j-ease), box-shadow 500ms var(--j-ease); }
    :root:not([data-a11y-motion]) .jv.is-live .jv-media :global(img) { transition: opacity 600ms var(--j-ease); }
    :root:not([data-a11y-motion]) .jv.is-live .jv-num { transition: background-color 400ms var(--j-ease), color 400ms var(--j-ease); }
    @media (min-width: 56.01rem) {
      :root:not([data-a11y-motion]) .jv.is-live .jv-step[data-active] { border-color: color-mix(in oklch, var(--fg) 30%, transparent); box-shadow: 0 30px 60px -40px oklch(20% 0.02 280 / 0.35); }
      :root:not([data-a11y-motion]) .jv.is-live .jv-step:not([data-active]) .jv-media :global(img) { opacity: 0.7; }
      :root:not([data-a11y-motion]) .jv.is-live .jv-step:not([data-active]) .jv-num { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1.5px var(--fg); }
    }
  }

  /* ==========================================================================
     5 · Training and experience
     ========================================================================== */
  .jx-cred { padding-block: 0 var(--j-sec); }
  .jx-cred-quote { font-size: var(--j-statement); font-weight: var(--j-w-display); line-height: calc(var(--j-lh-h3) + 0.03); letter-spacing: var(--j-tr-h3); max-inline-size: 20em; }
  .jx-ledger { border-block-end: 1px solid var(--j-hair); }
  .jx-group { padding-block: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem); border-block-start: 1px solid var(--j-hair); }
  .jx-group h3 { font-family: var(--font-body); font-size: var(--j-body); font-weight: var(--j-w-strong); letter-spacing: 0; line-height: 1.5; color: var(--fg); }
  .jx-rows { display: grid; gap: var(--space-l); }
  .jx-rows li { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0.15rem var(--space-m); align-items: baseline; }
  .jx-year { color: var(--muted); font-variant-numeric: tabular-nums; font-size: var(--j-small); line-height: 1.5; }
  .jx-row-main { display: grid; gap: 0.1rem; }
  .jx-row-t { font-size: var(--j-lead); font-weight: var(--j-w-strong); line-height: 1.35; letter-spacing: var(--j-tr-h3); }
  .jx-row-p { color: var(--muted); font-size: var(--j-small); line-height: 1.5; }
  .jx-rows-plain { gap: var(--space-xs); }
  .jx-rows-plain li { display: block; }
  .jx-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .jx-tags li { padding: 0.4rem 1rem; border-radius: 999px; background: var(--jr-sage); font-size: var(--j-small); font-weight: var(--j-w-strong); line-height: 1.5; }

  /* ==========================================================================
     6 · FAQ
     ========================================================================== */
  .jx-faq-panel { padding: var(--j-sec) clamp(1rem, 0.5rem + 3vw, 3rem); border-radius: var(--j-r-l); background: var(--jr-sage); }
  .jx-faq-inner { max-inline-size: 48rem; margin-inline: auto; }
  .jx-faq :global(.faq) { display: grid; gap: var(--space-xs); }
  .jx-faq :global(.faq details) { border: 1px solid oklch(100% 0 none / 0.85); border-radius: var(--j-r-m); background: oklch(100% 0 none / 0.62); transition: background-color 250ms var(--j-ease); }
  .jx-faq :global(.faq details[open]) { background: var(--surface); }
  .jx-faq :global(.faq summary) { overflow-wrap: anywhere; font-size: var(--j-lead); font-weight: var(--j-w-strong); line-height: 1.4; letter-spacing: var(--j-tr-h3); min-block-size: 4rem; padding: 0.9rem 1.5rem; padding-inline-end: 1rem; }
  .jx-faq :global(.faq summary svg) { inline-size: 2.25rem; block-size: 2.25rem; padding: 0.55rem; border-radius: 50%; background: var(--fg); color: #fff; }
  .jx-faq :global(.faq-a) { padding-inline: 1.5rem; padding-block-end: 1.5rem; color: var(--muted); max-inline-size: 38em; }

  /* ==========================================================================
     7 · Location and hours
     ========================================================================== */
  .jx-loc { padding-block: var(--j-sec); }
  .jx-loc-photo .jx-mask { aspect-ratio: 4 / 5; }
