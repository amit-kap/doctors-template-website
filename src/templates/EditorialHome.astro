---
/**
 * B · EDITORIAL — academic profile (reference: royhod.com, remermd.com).
 * The doctor's name and CV lead. Serif display, paper tones, thin rules, numbered index of services.
 */
import { site } from '../site.config';
import { href, whatsappHref, type Ctx } from '../i18n';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import Hours from '../components/Hours.astro';
import Credentials from '../components/Credentials.astro';
import Faq from '../components/Faq.astro';
import License from '../components/License.astro';

interface Props { ctx: Ctx }
const { ctx } = Astro.props;
const { t } = ctx;
const d = t.doctor;
const wa = whatsappHref();
const bookHref = site.contact.bookingUrl || href(ctx, 'appointment');
let n = 0;
---
<section class="masthead wrap">
  <div class="mh-text">
    <p class="eyebrow">{d.specialty}</p>
    <h1 class="mh-name">{d.fullName}</h1>
    <p class="mh-intro">{d.headline}</p>
    <div class="mh-actions">
      <a class="btn btn-primary" href={bookHref}>{t.ui.book}<Icon name="arrow" /></a>
      <a class="mh-phone" href={`tel:${site.contact.phoneHref}`}><Icon name="phone" /><span dir="ltr">{site.contact.phone}</span></a>
      {wa && <a class="mh-phone" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" />{t.ui.whatsapp}<span class="visually-hidden"> {t.ui.newWindow}</span></a>}
    </div>
  </div>
  <figure class="mh-photo">
    <Img ctx={ctx} name={site.doctor.portrait} width={900} height={1100} eager sizes="(max-width: 52rem) 90vw, 34vw" />
  </figure>
</section>

<section class="quote-sec" aria-label={d.philosophy}>
  <div class="wrap">
    <blockquote class="quote"><p>{d.philosophy}</p></blockquote>
  </div>
</section>

<section class="section" aria-labelledby="bio-h">
  <div class="wrap two-col">
    <div class="col-head">
      <h2 id="bio-h">{t.ui.nav.about}</h2>
      <License ctx={ctx} />
    </div>
    <div class="stack bio" style="--stack: var(--space-l)">
      {d.bio.map((p) => <p>{p}</p>)}
      <a class="text-link" href={href(ctx, 'about')}>{t.ui.aboutMore}<Icon name="arrow" /></a>
    </div>
  </div>
</section>

<section class="section-tight rule-top" aria-labelledby="cv-h">
  <div class="wrap two-col">
    <div class="col-head"><h2 id="cv-h">{t.ui.credentialsTitle}</h2></div>
    <Credentials ctx={ctx} variant="timeline" />
  </div>
</section>

<section class="section rule-top" aria-labelledby="svc-h">
  <div class="wrap two-col">
    <div class="col-head">
      <h2 id="svc-h">{t.ui.nav.services}</h2>
      <p class="muted">{d.intro}</p>
    </div>
    <div class="index">
      {t.serviceGroups.map((g) => (
        <section aria-labelledby={`ix-${g.id}`}>
          <h3 id={`ix-${g.id}`} class="ix-group">{g.title}</h3>
          <ol role="list">
            {t.services.filter((s) => s.group === g.id).map((s) => (
              <li class="ix-row">
                <span class="ix-n" aria-hidden="true">{String(++n).padStart(2, '0')}</span>
                <a class="ix-title" href={href(ctx, 'services', ctx.lang, `#${s.id}`)}>{s.title}</a>
                <p class="ix-sum">{s.summary}</p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</section>

<figure class="plate" aria-hidden="true" data-decor>
  <Img ctx={ctx} name="interior-detail" decorative width={1600} height={900} />
</figure>

<section class="section" aria-labelledby="visit-h">
  <div class="wrap colophon">
    <div>
      <h2 id="visit-h" class="col-h">{t.ui.address}</h2>
      <p class="big">{t.address.street}<br />{t.address.city}</p>
      <p class="muted">{t.address.notes}</p>
    </div>
    <div>
      <h2 class="col-h">{t.ui.hours}</h2>
      <Hours ctx={ctx} compact />
    </div>
    <div>
      <h2 class="col-h">{t.ui.insuranceTitle}</h2>
      <p>{t.insurance.text}</p>
      <p class="muted ins-list">{t.insurance.items.join(' · ')}</p>
    </div>
  </div>
</section>

<section class="section-tight rule-top" aria-labelledby="faq-h">
  <div class="wrap two-col">
    <div class="col-head"><h2 id="faq-h">{t.ui.faqTitle}</h2></div>
    <Faq ctx={ctx} />
  </div>
</section>

<section class="closing section" aria-labelledby="close-h">
  <div class="wrap closing-inner">
    <h2 id="close-h">{t.appointment.title}</h2>
    <p class="lead">{t.appointment.intro}</p>
    <div class="mh-actions">
      <a class="btn btn-primary" href={bookHref}>{t.ui.book}<Icon name="arrow" /></a>
      <a class="mh-phone" href={`tel:${site.contact.phoneHref}`}><Icon name="phone" /><span dir="ltr">{site.contact.phone}</span></a>
    </div>
  </div>
</section>

<style>
  .masthead { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(2rem, 1rem + 5vw, 6rem); align-items: end; padding-block: clamp(3rem, 1.5rem + 6vw, 7rem) var(--space-2xl); border-block-end: 1px solid var(--fg); }
  .mh-text { display: grid; gap: var(--space-l); }
  .mh-name { font-size: clamp(2.8rem, 1.6rem + 5.4vw, 6.5rem); line-height: 0.98; letter-spacing: -0.02em; font-weight: 500; }
  .mh-intro { font-size: var(--step-2); font-family: var(--font-display); line-height: 1.3; max-inline-size: 22em; color: var(--muted); }
  .mh-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s) var(--space-l); }
  .mh-actions .btn :global(svg), .text-link :global(svg) { inline-size: 1.1em; block-size: 1.1em; }
  .mh-phone { display: inline-flex; align-items: center; gap: 0.45em; color: var(--fg); font-weight: 600; min-block-size: 2.75rem; }
  .mh-phone :global(svg) { inline-size: 1.1em; block-size: 1.1em; }
  .mh-photo :global(img) { inline-size: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(0.85); }

  .quote-sec { padding-block: var(--section); }
  .quote { max-inline-size: 22em; margin-inline: auto; text-align: center; font-family: var(--font-display); font-size: var(--step-4); line-height: 1.2; }
  .quote p::before { content: '״'; display: block; color: var(--primary); font-size: 1.6em; line-height: 0.6; }
  :lang(en) .quote p::before { content: '“'; }

  .two-col { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl); align-items: start; }
  .col-head { display: grid; gap: var(--space-m); position: sticky; inset-block-start: 6rem; }
  .col-head h2 { font-size: var(--step-3); }
  .rule-top { border-block-start: 1px solid var(--line); }
  .bio { font-size: var(--step-1); line-height: 1.7; max-inline-size: 36em; }
  .text-link { display: inline-flex; align-items: center; gap: 0.4em; font-weight: 600; }

  .index { display: grid; gap: var(--space-2xl); }
  .ix-group { font-family: var(--font-body); font-size: var(--step--1); font-weight: 700; letter-spacing: 0.06em; color: var(--muted); margin-block-end: var(--space-s); }
  .ix-row { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.2rem var(--space-m); padding-block: var(--space-l); border-block-start: 1px solid var(--line); }
  .ix-n { grid-row: span 2; font-family: var(--font-display); font-size: var(--step-2); color: var(--primary); line-height: 1; font-variant-numeric: tabular-nums; }
  .ix-title { font-family: var(--font-display); font-size: var(--step-2); color: var(--fg); text-decoration: none; line-height: 1.2; }
  .ix-sum { color: var(--muted); }
  @media (hover: hover) and (pointer: fine) { .ix-title:hover { color: var(--primary); text-decoration: underline; } }

  .plate :global(img) { inline-size: 100%; block-size: clamp(14rem, 8rem + 20vw, 30rem); object-fit: cover; filter: saturate(0.8); }

  .colophon { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-2xl); }
  .colophon > div { display: grid; gap: var(--space-s); align-content: start; padding-block-start: var(--space-m); border-block-start: 3px solid var(--fg); }
  .col-h { font-family: var(--font-body); font-size: var(--step--1); font-weight: 700; letter-spacing: 0.06em; color: var(--muted); }
  .big { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.25; }
  .ins-list { font-size: var(--step--1); }

  .closing { background: var(--surface-2); }
  .closing-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-l); }
  .closing-inner h2 { font-size: var(--step-4); }

  @media (max-width: 52rem) {
    .masthead, .two-col { grid-template-columns: 1fr; }
    .mh-photo { max-inline-size: 24rem; }
    .col-head { position: static; }
  }
</style>
