---
/** Small ↗ arrow for pill buttons and links. Decorative; points the reading direction in RTL. */
---
<svg class="jr-arrow" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
  <path d="M3.2 8.8 8.6 3.4M4.2 3.2h4.6v4.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
<style>
  .jr-arrow { display: inline-block; inline-size: 0.7em; block-size: 0.7em; flex: none; }
  :global([dir='rtl']) .jr-arrow { scale: -1 1; }
</style>
